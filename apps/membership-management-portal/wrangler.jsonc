/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	// ROUTES AND VARS ARE DEFINED IN THE DASHBOARD; DO NOT INCLUDE
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "membership-worker",
	"main": "src/index.ts",
	"keep_vars": true, // we specify vars in the dashboard and .dev.vars, not here
	"workers_dev": false,
	"preview_urls": false,
	"compatibility_date": "2026-10-06",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "membership_db",
			"database_name": "membership-db",
			"database_id": "ab794423-0f4e-47ac-b474-835a0d3d3c1a",
			"preview_database_id": "ba637e2c-967c-4d16-911d-adb644a0a3c6", // IDENTICAL to previews block below
			"migrations_dir": "drizzle",
			"remote": true // unless running with --local! this is okay because dev uses preview_database_id
		}
	],
	"previews": {
		"d1_databases": [
			{
				"binding": "membership_db",
				"database_name": "membership-db-staging",
				"database_id": "ba637e2c-967c-4d16-911d-adb644a0a3c6",
				"migrations_dir": "drizzle"
			}
		]
	},
	// `pnpm staging` runs the test UI locally with `-e staging`: bindings aren't inherited, so it
	// has no D1 binding (the test UI supplies the shared staging database itself). Never deploy it.
	"env": {
		"staging": {}
	}
}
