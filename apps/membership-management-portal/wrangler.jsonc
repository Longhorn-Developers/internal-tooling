/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "membership-worker",
	"main": "src/index.ts",
	"keep_vars": true, // we specify vars in the dashboard and .dev.vars, not here
	"routes": [
		{ "pattern": "webhook.longhorndevelopers.org/mmp-github", "zone_name": "longhorndevelopers.org" }
	],
	"workers_dev": false,
	"preview_urls": false,
	"compatibility_date": "2026-10-06",
	"env": {
		"staging": {
			"routes": [
				{ "pattern": "webhook.staging.longhorndevelopers.org/mmp-github", "zone_name": "longhorndevelopers.org" }
			]
		}
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "membership_db",
			"database_name": "membership-db",
			"database_id": "474c5c06-a8c1-474a-942b-bfb6e23b3a19",
			"migrations_dir": "drizzle"
		}
	],
	"previews": {
		"d1_databases": [
			{
				"binding": "membership_db",
				"database_name": "membership-db-staging",
				"database_id": "ba637e2c-967c-4d16-911d-adb644a0a3c6",
				"migrations_dir": "drizzle"
			}
		]
	},
	"vars": {
		/* ===== ENVIRONMENT VARIABLES =====
		 * Secrets do NOT live here; this is only declarations for typing and documentation purposes.
		 * To find all applicable staging environment variables, go to the Notion.
		 * You can set them manually or just download the provided .dev.vars file.
		 * https://app.notion.com/p/longhorn-developers/Membership-Management-Portal-3f7d9cb37133803eb6b5cedd0048409c
		 */
		"GITHUB_ORG": "", // e.g. "Longhorn-Developers"
		"GITHUB_APP_ID": "",
		"GITHUB_APP_INSTALLATION_ID": "",
		"GITHUB_APP_PRIVATE_KEY": "", // PKCS#8 PEM ("BEGIN PRIVATE KEY"); escaped \n is fine
		"GITHUB_EXEC_TEAM": "", // name of the exec team
		"GITHUB_LEADS_TEAM": "", // name of the leads team
		"GITHUB_WEBHOOK_SECRET": "" // secret used for validating GitHub webhook
	}
}
